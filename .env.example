# ==============================================================================
# The Relay (Vaani) Configuration Environment Variables
# ==============================================================================

# Groq Cloud API Key (Required for live inference mode)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM Model for RAG Corpus Question Answering (Default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Groq LLM Model for DIRECT_LLM Conversational Chat (Default: qwen/qwen3.8-27b)
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# Optional Hugging Face Token (to avoid rate limits on Hugging Face model downloads)
# HF_TOKEN=hf_your_huggingface_token_here
